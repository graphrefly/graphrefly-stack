{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "urn:graphrefly-stack:schema:consequence-projection:v1",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema",
		"id",
		"subject",
		"blueprint",
		"manifestId",
		"changeId",
		"sourceScope",
		"direct",
		"reachable",
		"verificationRequired",
		"verifiedUnchanged",
		"unknowns",
		"coverage",
		"provenance",
		"readiness"
	],
	"properties": {
		"schema": { "const": "graphrefly.stack.consequence-projection.v1" },
		"id": { "$ref": "#/definitions/Digest" },
		"subject": { "$ref": "#/definitions/Subject" },
		"blueprint": { "$ref": "#/definitions/Blueprint" },
		"manifestId": { "$ref": "#/definitions/Digest" },
		"changeId": { "$ref": "#/definitions/Digest" },
		"sourceScope": { "$ref": "#/definitions/Labels" },
		"direct": {
			"type": "array",
			"maxItems": 64,
			"uniqueItems": true,
			"items": { "$ref": "#/definitions/Direct" }
		},
		"reachable": {
			"type": "array",
			"maxItems": 256,
			"uniqueItems": true,
			"items": { "$ref": "#/definitions/Reachable" }
		},
		"verificationRequired": { "$ref": "#/definitions/Labels" },
		"verifiedUnchanged": {
			"type": "array",
			"maxItems": 64,
			"uniqueItems": true,
			"items": { "$ref": "#/definitions/Unchanged" }
		},
		"unknowns": {
			"type": "array",
			"maxItems": 128,
			"uniqueItems": true,
			"items": { "$ref": "#/definitions/Unknown" }
		},
		"coverage": {
			"type": "object",
			"additionalProperties": false,
			"required": ["bindings", "evidence", "declared"],
			"properties": {
				"bindings": { "enum": ["complete", "incomplete"] },
				"evidence": { "enum": ["complete", "incomplete"] },
				"declared": { "$ref": "#/definitions/Labels" }
			}
		},
		"provenance": {
			"type": "object",
			"additionalProperties": false,
			"required": ["sourceResolutionRefs", "bindingRefs", "authorityRefs", "manifestId"],
			"properties": {
				"sourceResolutionRefs": { "$ref": "#/definitions/Digests" },
				"bindingRefs": { "$ref": "#/definitions/Digests" },
				"authorityRefs": { "$ref": "#/definitions/Labels" },
				"manifestId": { "$ref": "#/definitions/Digest" }
			}
		},
		"readiness": {
			"type": "object",
			"additionalProperties": false,
			"required": ["status", "reasons"],
			"properties": {
				"status": { "enum": ["verified", "blocked", "stale", "unknown"] },
				"reasons": { "$ref": "#/definitions/Labels" }
			}
		}
	},
	"definitions": {
		"Digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
		"Oid": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
		"Label": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\x00-\\x1f]+$" },
		"Labels": {
			"type": "array",
			"maxItems": 256,
			"uniqueItems": true,
			"items": { "$ref": "#/definitions/Label" }
		},
		"Digests": {
			"type": "array",
			"maxItems": 256,
			"uniqueItems": true,
			"items": { "$ref": "#/definitions/Digest" }
		},
		"Subject": {
			"type": "object",
			"additionalProperties": false,
			"required": ["repository", "base", "head"],
			"properties": {
				"repository": { "$ref": "#/definitions/Label" },
				"base": { "$ref": "#/definitions/Oid" },
				"head": { "$ref": "#/definitions/Oid" }
			}
		},
		"Blueprint": {
			"type": "object",
			"additionalProperties": false,
			"required": ["version", "topologyHash"],
			"properties": {
				"version": { "const": "graphrefly.blueprint.v2" },
				"topologyHash": { "$ref": "#/definitions/Digest" }
			}
		},
		"Direct": {
			"type": "object",
			"additionalProperties": false,
			"required": ["nodeId", "bindingRef"],
			"properties": {
				"nodeId": { "$ref": "#/definitions/Label" },
				"bindingRef": { "$ref": "#/definitions/Digest" }
			}
		},
		"Reachable": {
			"type": "object",
			"additionalProperties": false,
			"required": ["from", "to", "path"],
			"properties": {
				"from": { "$ref": "#/definitions/Label" },
				"to": { "$ref": "#/definitions/Label" },
				"path": {
					"type": "array",
					"minItems": 2,
					"maxItems": 128,
					"items": { "$ref": "#/definitions/Label" }
				}
			}
		},
		"Unchanged": {
			"type": "object",
			"additionalProperties": false,
			"required": ["scope", "verifierRef", "verifierDigest"],
			"properties": {
				"scope": { "$ref": "#/definitions/Label" },
				"verifierRef": { "$ref": "#/definitions/Label" },
				"verifierDigest": { "$ref": "#/definitions/Digest" }
			}
		},
		"Unknown": {
			"type": "object",
			"additionalProperties": false,
			"required": ["code", "subject"],
			"properties": {
				"code": {
					"enum": [
						"AMBIGUOUS_SOURCE",
						"CHANGED_SOURCE",
						"DELETED_SOURCE",
						"MISSING_SOURCE",
						"MOVED_SOURCE",
						"UNRESOLVED_SOURCE",
						"UNSUPPORTED_SOURCE",
						"STALE_SOURCE",
						"MISSING_BINDING",
						"BINDING_MISMATCH",
						"MISSING_EVIDENCE",
						"STALE_EVIDENCE",
						"INCOMPLETE_COVERAGE"
					]
				},
				"subject": { "$ref": "#/definitions/Label" }
			}
		}
	}
}
