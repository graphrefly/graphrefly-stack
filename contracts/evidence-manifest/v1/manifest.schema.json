{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema", "id", "subject", "blueprint", "bindingRefs", "authorities", "coverage"],
	"properties": {
		"schema": {
			"const": "graphrefly.stack.evidence-manifest.v1"
		},
		"id": {
			"type": "string",
			"pattern": "^[a-f0-9]{64}$"
		},
		"subject": {
			"type": "object",
			"additionalProperties": false,
			"required": ["repository", "base", "head"],
			"properties": {
				"repository": {
					"type": "string",
					"minLength": 1,
					"maxLength": 500
				},
				"base": {
					"type": "string",
					"pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
				},
				"head": {
					"type": "string",
					"pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
				}
			}
		},
		"blueprint": {
			"type": "object",
			"additionalProperties": false,
			"required": ["version", "topologyHash"],
			"properties": {
				"version": {
					"const": "graphrefly.blueprint.v2"
				},
				"topologyHash": {
					"type": "string",
					"pattern": "^[a-f0-9]{64}$"
				}
			}
		},
		"bindingRefs": {
			"type": "array",
			"minItems": 1,
			"maxItems": 64,
			"uniqueItems": true,
			"items": {
				"type": "string",
				"pattern": "^[a-f0-9]{64}$"
			}
		},
		"authorities": {
			"type": "array",
			"minItems": 1,
			"maxItems": 64,
			"uniqueItems": true,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"ref",
					"kind",
					"owner",
					"schema",
					"location",
					"digest",
					"bindingRefs",
					"provenance",
					"freshness"
				],
				"properties": {
					"ref": {
						"type": "string",
						"minLength": 1,
						"maxLength": 500
					},
					"kind": {
						"enum": ["decision", "policy", "test", "verifier", "artifact"]
					},
					"owner": {
						"type": "string",
						"minLength": 1,
						"maxLength": 500
					},
					"schema": {
						"type": "string",
						"minLength": 1,
						"maxLength": 500
					},
					"location": {
						"type": "object",
						"additionalProperties": false,
						"required": ["repository", "commit", "path", "selector", "occurrence"],
						"properties": {
							"repository": {
								"type": "string",
								"minLength": 1,
								"maxLength": 500
							},
							"commit": {
								"anyOf": [
									{
										"type": "string",
										"pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
									},
									{
										"type": "null"
									}
								]
							},
							"path": {
								"type": "string",
								"minLength": 1,
								"maxLength": 500,
								"pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:\\x00-\\x1f])(?!.*//).+[^/]$"
							},
							"selector": {
								"type": ["string", "null"],
								"maxLength": 500
							},
							"occurrence": {
								"anyOf": [
									{
										"type": "string",
										"pattern": "^[a-f0-9]{64}$"
									},
									{
										"type": "null"
									}
								]
							}
						},
						"oneOf": [
							{
								"properties": {
									"commit": {
										"type": "string"
									},
									"occurrence": {
										"type": "null"
									}
								}
							},
							{
								"properties": {
									"commit": {
										"type": "null"
									},
									"occurrence": {
										"type": "string"
									}
								}
							}
						]
					},
					"digest": {
						"type": "string",
						"pattern": "^[a-f0-9]{64}$"
					},
					"bindingRefs": {
						"type": "array",
						"minItems": 1,
						"maxItems": 64,
						"uniqueItems": true,
						"items": {
							"type": "string",
							"pattern": "^[a-f0-9]{64}$"
						}
					},
					"provenance": {
						"type": "object",
						"additionalProperties": false,
						"required": ["tool", "version", "scope", "sources"],
						"properties": {
							"tool": {
								"type": "string",
								"minLength": 1,
								"maxLength": 500
							},
							"version": {
								"type": "string",
								"minLength": 1,
								"maxLength": 500
							},
							"scope": {
								"type": "string",
								"minLength": 1,
								"maxLength": 500
							},
							"sources": {
								"type": "array",
								"minItems": 1,
								"maxItems": 64,
								"uniqueItems": true,
								"items": {
									"type": "object",
									"additionalProperties": false,
									"required": ["repository", "commit", "path", "selector", "occurrence"],
									"properties": {
										"repository": {
											"type": "string",
											"minLength": 1,
											"maxLength": 500
										},
										"commit": {
											"anyOf": [
												{
													"type": "string",
													"pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
												},
												{
													"type": "null"
												}
											]
										},
										"path": {
											"type": "string",
											"minLength": 1,
											"maxLength": 500,
											"pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:\\x00-\\x1f])(?!.*//).+[^/]$"
										},
										"selector": {
											"type": ["string", "null"],
											"maxLength": 500
										},
										"occurrence": {
											"anyOf": [
												{
													"type": "string",
													"pattern": "^[a-f0-9]{64}$"
												},
												{
													"type": "null"
												}
											]
										}
									},
									"oneOf": [
										{
											"properties": {
												"commit": {
													"type": "string"
												},
												"occurrence": {
													"type": "null"
												}
											}
										},
										{
											"properties": {
												"commit": {
													"type": "null"
												},
												"occurrence": {
													"type": "string"
												}
											}
										}
									]
								}
							}
						}
					},
					"freshness": {
						"type": "object",
						"additionalProperties": false,
						"required": ["status", "subject", "authorityDigest"],
						"properties": {
							"status": {
								"enum": ["current", "stale", "unknown"]
							},
							"subject": {
								"type": "object",
								"additionalProperties": false,
								"required": ["repository", "base", "head"],
								"properties": {
									"repository": {
										"type": "string",
										"minLength": 1,
										"maxLength": 500
									},
									"base": {
										"type": "string",
										"pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
									},
									"head": {
										"type": "string",
										"pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
									}
								}
							},
							"authorityDigest": {
								"type": "string",
								"pattern": "^[a-f0-9]{64}$"
							}
						}
					}
				}
			}
		},
		"coverage": {
			"type": "object",
			"additionalProperties": false,
			"required": ["runtimeOccurrence", "scope"],
			"properties": {
				"runtimeOccurrence": {
					"const": "absent"
				},
				"scope": {
					"const": "retained-refresh-session-required-linkage-only"
				}
			}
		}
	}
}
